<?xml version="1.0" encoding="utf-8"?>
<!-- Disable cloud backup and device transfer for every supported data domain. -->
<!-- 对全部受支持的数据域禁用云备份与设备迁移。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="root"
            path="." />
        <exclude
            domain="file"
            path="." />
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="sharedpref"
            path="." />
        <exclude
            domain="external"
            path="." />
    </cloud-backup>

    <device-transfer>
        <exclude
            domain="root"
            path="." />
        <exclude
            domain="file"
            path="." />
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="sharedpref"
            path="." />
        <exclude
            domain="external"
            path="." />
    </device-transfer>
</data-extraction-rules>
